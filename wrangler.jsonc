{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "time-restricted",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "time-restricted"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "time-restricted-next-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "time-restricted-next-tag-cache",
      "database_id": "2d4e037c-378a-4cfd-b0cd-10f4e1768d47"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "USE_WORKERMAILER": "true",
    "SITE_URL": "https://time-restricted.com",
    "WORDPRESS_API_URL": "https://api.time-restricted.com/graphql",
    "WORDPRESS_REDIRECTION_API_URL": "https://api.time-restricted.com/wp-json/redirection/v1/redirect",
    "WORDPRESS_REDIRECTION_CACHE_TTL_SECONDS": "86400",
    "SMTP_HOST": "smtp.purelymail.com",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "false"
  }
}
